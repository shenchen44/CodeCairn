# Optional GitHub publication
CODECAIRN_GITHUB_TOKEN=
CODECAIRN_GITHUB_API_BASE=https://api.github.com
CODECAIRN_GITHUB_INSTALLATION_ID=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=

# Optional sandbox overrides
SANDBOX_BASE_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPU_LIMIT=1.0
SANDBOX_UID=
SANDBOX_GID=

# Pi mutation gate: block, warn, or off
CODECAIRN_GATE_MODE=block
